{
  "name": "dsh-pupu-notes",
  "version": "0.1.0",
  "description": "Independent character notebooks and autonomous memory tools for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "pupu-notes-mcp": "./dist/mcp.mjs"
  },
  "main": "./dist/host.mjs",
  "types": "./dist/types/contracts.d.ts",
  "files": [
    "dist/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "pack:local": "npm run check && node -e \"require('fs').mkdirSync('artifacts',{recursive:true})\" && npm pack --pack-destination artifacts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "fflate": "0.8.3",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2"
  },
  "exports": {
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": {
      "default": "./dist/client.js"
    },
    ".": {
      "types": "./dist/types/host/index.d.ts",
      "default": "./dist/host.mjs"
    }
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
